# Copiez ce fichier en .env.local et renseignez vos propres valeurs.
# Trouvez ces informations dans votre projet Supabase : Project Settings > API.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-clé-anon-publique

# Clé service_role (Project Settings > API, section « Service role »). Elle
# contourne totalement les RLS : à garder strictement côté serveur, ne jamais
# la préfixer par NEXT_PUBLIC_. Requise par la tâche planifiée de rappel
# avant intervention (src/lib/supabase/service-role.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Optionnel : force l'origine utilisée pour les liens e-mail (confirmation,
# réinitialisation). Utile en production derrière un proxy. En local, laissez
# vide (déduit automatiquement de http://localhost:3000).
NEXT_PUBLIC_SITE_URL=

# --- Stripe (covoiturage et paiement en ligne) ---
# Clé secrète du compte Stripe (Développeurs > Clés d'API). Utilisez la clé de
# test (sk_test_...) en local. Sans elle, les paiements lèvent une erreur ;
# le reste de l'application continue de fonctionner.
STRIPE_SECRET_KEY=

# Secret de signature du webhook (Développeurs > Webhooks > votre endpoint).
# En local, `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# affiche un secret whsec_... à coller ici.
STRIPE_WEBHOOK_SECRET=

# --- Tâche planifiée (Vercel Cron) ---
# Secret partagé protégeant /api/cron/reminders : la route refuse toute
# requête dont l'en-tête Authorization n'est pas « Bearer <CRON_SECRET> ».
# Générez une valeur aléatoire et déclarez-la aussi dans Vercel.
CRON_SECRET=
